# 可选的环境变量模板
# 复制为 .env.local 后按需填入真实 API 信息
# 未配置时前端全部走本地 Mock 数据（默认推荐离线体验）

# -----------------------------
# AI 设计（Dify 概念方案生成）
# -----------------------------
# DIFY_API_URL=https://api.dify.ai
# DIFY_API_KEY=app-xxx

# -----------------------------
# AI 图像（ComfyUI 效果图渲染）
# -----------------------------
# COMFYUI_API_URL=http://localhost:8188

# -----------------------------
# AI 视频（Seedance 视频生成）
# -----------------------------
# SEEDANCE_API_URL=https://api.seedance.com
# SEEDANCE_API_KEY=sk-xxx

# -----------------------------
# AI PPT / 网页（千问 API）
# -----------------------------
# QWEN_API_URL=https://dashscope.aliyuncs.com
# QWEN_API_KEY=sk-xxx

# -----------------------------
# 服务器（一般无需修改）
# -----------------------------
# PORT=5000
# HOSTNAME=localhost

# -----------------------------
# TOS 对象存储（静态资源 CDN 加速，可选）
# 未配置时所有资源走本地 public/，配置后公开桶 URL 自动生效
# -----------------------------
# 客户端可见（构建时内联到 JS，控制 asset() 转换行为）：
# NEXT_PUBLIC_TOS_BASE_URL=https://your-bucket.tos-s3-cn-beijing.volces.com
# 上传脚本专用（不入客户端包，仅 scripts/upload-to-tos.mjs 使用）：
# TOS_ENDPOINT=https://tos-s3-cn-beijing.volces.com
# TOS_REGION=cn-beijing
# TOS_BUCKET=your-bucket
# TOS_ACCESS_KEY=AKxxx
# TOS_SECRET_KEY=Skxxx
